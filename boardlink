#!/usr/bin/env bash

# BoardLink Bash entry point for MobaXterm and other Bash terminals.
# Required environment variables:
#   export BOARDLINK_USER=root
#   export BOARDLINK_HOST=192.168.1.179

set -u

if [[ "${1:-}" == "doctor" ]]; then
    failed=0
    echo "BoardLink diagnosis"

    if command -v ssh >/dev/null 2>&1; then
        echo "[OK] ssh is available"
    else
        echo "[FAIL] ssh was not found"
        failed=1
    fi

    if command -v scp >/dev/null 2>&1; then
        echo "[OK] scp is available"
    else
        echo "[FAIL] scp was not found"
        failed=1
    fi

    if [[ -z "${BOARDLINK_USER:-}" || -z "${BOARDLINK_HOST:-}" ]]; then
        echo "[FAIL] BOARDLINK_USER or BOARDLINK_HOST is not configured"
        failed=1
    else
        target="${BOARDLINK_USER}@${BOARDLINK_HOST}"
        echo "Checking SSH connection to ${target} ..."
        remote_info=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$target" "uname -a" 2>&1)
        status=$?
        if [[ $status -eq 0 ]]; then
            echo "[OK] SSH connection"
            echo "      $remote_info"
        else
            echo "[FAIL] SSH connection"
            echo "      $remote_info"
            failed=1
        fi
    fi

    if [[ $failed -eq 0 ]]; then
        echo "Diagnosis completed: all checks passed."
        exit 0
    fi
    echo "Diagnosis completed: some checks failed."
    exit 1
fi

if [[ -z "${BOARDLINK_USER:-}" || -z "${BOARDLINK_HOST:-}" ]]; then
    echo "BoardLink is not configured."
    echo "Run: export BOARDLINK_USER=root"
    echo "Run: export BOARDLINK_HOST=192.168.1.179"
    exit 2
fi

target="${BOARDLINK_USER}@${BOARDLINK_HOST}"

if [[ "${1:-}" == "upload" ]]; then
    if [[ "$#" -ne 3 ]]; then
        echo 'Usage: boardlink upload "local-file" "board-path"'
        exit 2
    fi

    local_file="$2"
    board_path="$3"

    if [[ ! -f "$local_file" ]]; then
        echo "Local file not found: $local_file"
        exit 1
    fi

    echo "Uploading to ${target}:${board_path} ..."
    scp "$local_file" "${target}:${board_path}"
    status=$?
    if [[ $status -ne 0 ]]; then
        echo "Upload failed. Exit code: $status"
        exit "$status"
    fi

    echo "Upload completed."
    exit 0
fi

if [[ "$#" -lt 1 ]]; then
    echo 'Usage: boardlink "command"'
    echo '   or: boardlink upload "local-file" "board-path"'
    exit 2
fi

echo "Connecting to ${target} ..."
ssh "$target" "$@"
status=$?
if [[ $status -ne 0 ]]; then
    echo "Command failed. Exit code: $status"
    exit "$status"
fi

echo "Command completed."
